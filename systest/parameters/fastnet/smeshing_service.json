{
    "preset": "fastnet",
    "main": {
        "atx-versions": {
            "2": 2
        }
    },
    "api": {
        "grpc-public-listener": "0.0.0.0:9092",
        "grpc-private-listener": "0.0.0.0:9093",
        "privateServices": [
            "smesher",
            "debug"
        ],
        "publicServices": [
            "smeshing_identities_v2beta1"
        ]
    },
    "hare3": {
        "committeeupgrade": {
            "layer": 16,
            "size": 15
        }
    },
    "smeshing": {
        "smeshing-verifying-opts": {
            "smeshing-opts-verifying-min-workers": 1000000
        }
    },
    "certifier": {
        "client": {
            "max-retries": 10
        }
    },
    "logging": {
        "log-encoder": "json",
        "atxBuilder": "debug",
        "hare": "debug",
        "hareOracle": "debug",
        "nodeServiceClient": "debug"
    }
}
